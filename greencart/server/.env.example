# Server Environment Variables Example
PORT=4000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here

# Admin Credentials
SELLER_EMAIL=admin@example.com
SELLER_PASSWORD=your_admin_password

# MongoDB Connection String
MONGODB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/greencart?retryWrites=true&w=majority

# Cloudinary Setup
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe Setup
STRIPE_PUBLISHBLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx

# Allowed Client Origin for CORS (comma-separated if multiple, e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173,http://localhost:5174
